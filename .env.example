# 숲길동무 백엔드 환경변수 — 복사해 .env로 사용 (커밋 금지)
ENV=dev

# DB: 개발은 SQLite, 운영은 PostgreSQL(+PostGIS)
DATABASE_URL=sqlite:///./forestmate.db
# DATABASE_URL=postgresql+psycopg://forest:비밀번호@localhost:5432/forestmate

# 공공데이터포털 인증키 (활용신청 후 발급). 비우면 동일 스키마 스냅샷으로 폴백.
#   - 기상청 단기예보 / 산불위험예보 / 산악기상관측망 공통 키
DATA_GO_KR_KEY=

# AI 숲이 — 비우면 규칙 기반 의도 엔진으로 동작.
# Gemini 무료 티어: AI Studio에서 키 발급 후 GEMINI_API_KEY만 입력하면 기본 모델
# gemini-3.5-flash를 Google OpenAI-compatible endpoint로 호출한다.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Claude를 쓰려면 LLM_PROVIDER=claude, ANTHROPIC_API_KEY, LLM_MODEL=claude-opus-4-8로 설정.
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=12

# 위치정보 통계 표출 최소 군집(위치정보법). 운영 50, 개발 1.
K_ANONYMITY=1

# 조난 감지 — 이동 정지 임계(분), 평가 최소 포인트 수
DISTRESS_STALL_MINUTES=30
DISTRESS_MIN_POINTS=3

# CORS 허용 오리진(콤마 구분). 운영은 앱/웹 도메인만 명시.
CORS_ORIGINS=*

# 계정/소셜 로그인
# PUBLIC_BASE_URL이 비어 있으면 요청 Host 기준으로 OAuth redirect_uri를 만든다.
PUBLIC_BASE_URL=http://localhost:5181
AUTH_SESSION_DAYS=90
AUTH_STATE_TTL_MINUTES=10
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
